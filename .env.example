# Environment Configuration for Document Submission Portal
# Copy this file to .env and fill in secure values

# REQUIRED: Generate a secure random string (64+ characters)
# Run this in Node to generate: require('crypto').randomBytes(64).toString('hex')
SESSION_SECRET=CHANGE_ME_TO_SECURE_RANDOM_STRING_64_CHARS_MIN

# Server Configuration
NODE_ENV=production
# Set to production only when the reverse proxy forwards HTTPS traffic.
PORT=3000

# Security Settings
# Rate limiting: Max login attempts per 15 minutes
MAX_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_MS=900000

# Session timeout in milliseconds (default: 30 minutes)
SESSION_TIMEOUT_MS=1800000

# File Upload Settings
MAX_FILE_SIZE_MB=10